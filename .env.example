## Interactive Brokers (TWS / IB Gateway)
# Set these to match your local/network TWS settings.
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

## Groq (LLM veto)
GROQ_API_KEY=
# Where the veto layer appends its audit trail (default: ./veto_audit.log).
IQS_VETO_AUDIT_LOG=veto_audit.log

## Position sizing (technical strategy)
# Max notional per BUY order, in quote currency, and take-profit distance.
IQS_MAX_ORDER_NOTIONAL=2000
IQS_TP_PCT=0.06


## Cold path (daily calibration)
# Optional: comma-separated subset of symbols to calibrate. If empty, uses default universe.
IQS_COLDPATH_SYMBOLS=
# How many days of historical ticks to request from IB for calibration.
IQS_COLDPATH_DAYS_BACK=5
# Where to write calibration files (relative paths allowed).
IQS_COLDPATH_OUT_DIR=data/calibration

## Event-driven runtime (volume bars)
# Where cold path writes the latest calibration file.
IQS_CALIBRATION_PATH=data/calibration/calibration_latest.json
# Fallback if calibration file is missing for a symbol.
IQS_DEFAULT_BUCKET_VOLUME=10000
# Backpressure: max number of completed bars queued for processing.
IQS_BAR_QUEUE_MAX=1000
